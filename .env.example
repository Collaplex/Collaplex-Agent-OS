# Collaplex Agent — environment template. Copy to .env and fill in.
# Every model call is read from here; nothing is hard-coded in the source.

# ── Main line: shared by the main agent, the exec agent and the sub agent ──
# Point at a cloud endpoint …
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=sk-...
# … or at a local llama.cpp server (see `./start_models.sh start`):
#   OPENAI_BASE_URL=http://127.0.0.1:8790/v1
#   OPENAI_MODEL=qwen3-vl-8b
#   OPENAI_API_KEY=local

# ── Embedding model (used by the retrieval path) ──
EMBEDDING_BASE_URL=http://127.0.0.1:8199/v1
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_API_KEY=

# ── Memory store (required when the store backend is "pg") ──
RAG_PG_DSN=host=/var/run/postgresql dbname=collaplex_rag user=collaplex password=CHANGE_ME

# ── Optional: give the exec agent and/or the sub agent their own endpoint ──
# Both fall back to the main line when left empty.
# EXEC_BASE_URL= / EXEC_MODEL= / EXEC_API_KEY=
# SUBAGENT_BASE_URL= / SUBAGENT_MODEL= / SUBAGENT_API_KEY=

# ── Optional: cloud credentials for the outsource / cross-check skills ──
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MIMO_API_KEY=sk-...
# MIMO_BASE_URL=https://api.example.com/v1

# ── Misc ──
DEBUG=0
