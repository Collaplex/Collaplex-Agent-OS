<mxfile host="app.diagrams.net">
    <diagram name="1-链路" id="定时任务-链路">
        <mxGraphModel dx="1056" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
            <mxCell id="n_call" value="调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="356" y="40" width="120" height="60" as="geometry"/></mxCell>
            <mxCell id="n_wait" value="等待多长时间后开始或者结束动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="175" width="210" height="70" as="geometry"/></mxCell>
            <mxCell id="n_when" value="什么时间开始或者结束动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="175" width="210" height="70" as="geometry"/></mxCell>
            <mxCell id="n_thread" value="定时器线程&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;★ 倒计时走单调钟 / 闹钟走墙钟&lt;br&gt;★ 睡眠唤醒后补一次&lt;br&gt;★ 空 + 空闲 60 秒才关&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="300" width="190" height="90" as="geometry"/></mxCell>
            <mxCell id="n_dog" value="看门狗：定时器里没有任务了就关掉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="220" height="70" as="geometry"/></mxCell>
            <mxCell id="n_do" value="执行动作&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;＝ 提醒主 agent（不替它干业务）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="170" height="70" as="geometry"/></mxCell>
            <mxCell id="n_back" value="返回结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="170" height="60" as="geometry"/></mxCell>
            <mxCell id="n_store" value="落盘：定时器表（state/timers.json）&lt;br&gt;线程登记 / 取消就写它&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;★ 跨重启：启动时读回来重挂&lt;br&gt;★ 过期条目补一次，并说明是补的&lt;br&gt;★ 自检里查它（能读且非空）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="220" height="110" as="geometry"/></mxCell>
            <mxCell id="n_undo" value="撤销 / 列表&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;入口的另两个动作：&lt;br&gt;按 id 或「最近那条」撤掉；看现在挂着几条&lt;br&gt;★ 同一件事在设置页也有一节（看 / 撤）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="300" width="210" height="100" as="geometry"/></mxCell>
            <mxCell id="n_tick" value="过程步骤里读秒&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;阻塞式等的时候：&lt;br&gt;「过程」面板里一格原地读秒&lt;br&gt;（不每秒新起一格）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="210" height="90" as="geometry"/></mxCell>
            <mxCell id="n_note" value="旁注 · 不属于主流程&lt;br&gt;————————————&lt;br&gt;阻塞 / 非阻塞，由主 agent 声明：&lt;br&gt;［阻塞式］就在这一轮对话里等&lt;br&gt;　硬上限 &lt;b&gt;180 分钟&lt;/b&gt;；超了程序判条件不足 →&lt;br&gt;　子 agent 把可选参数提醒给主 agent&lt;br&gt;［非阻塞式］主 agent 先走，到点回来提醒它&lt;br&gt;　（排队，等它下一轮开场注入，不插话）&lt;br&gt;两种都走同一条定时器线程。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="250" height="220" as="geometry"/></mxCell>
            <mxCell id="n_legend" value="蓝＝原稿保留　绿＝后续新增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="220" height="40" as="geometry"/></mxCell>
            <mxCell id="e_call_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_call" target="n_wait"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_call_when" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_call" target="n_when"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_wait_thread" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_wait" target="n_thread"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_when_thread" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_when" target="n_thread"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_thread_do" value="到点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_thread" target="n_do"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_do_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_do" target="n_back"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_dog_thread" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_dog" target="n_thread"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_store_thread" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.78;entryDx=0;entryDy=0;startArrow=classic;" edge="1" parent="1" source="n_store" target="n_thread"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_undo_thread" value="撤 / 查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;startArrow=classic;" edge="1" parent="1" source="n_undo" target="n_thread"><mxGeometry relative="1" as="geometry"/></mxCell>
            <mxCell id="e_tick_thread" value="阻塞式：等的时候" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_thread" target="n_tick"><mxGeometry relative="1" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="2-定档与判据" id="定时任务-定档判据">
        <mxGraphModel dx="1056" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
            <mxCell id="p2_t" value="定时任务 skill · 定档与判据（2026-10-09 审计后补）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;页 1 是链路；这一页是没画进链路里的决定，一条一行。参数类（上限 20 条 / 空闲 60 秒 / 过期补一次 / 排队 / 单调钟）按授权定档。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="750" height="60" as="geometry"/></mxCell>
            <mxCell id="p2_h1" value="项" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="160" height="34" as="geometry"/></mxCell>
            <mxCell id="p2_h2" value="定法（判据 / 参数）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="96" width="330" height="34" as="geometry"/></mxCell>
            <mxCell id="p2_h3" value="为什么这么定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="96" width="240" height="34" as="geometry"/></mxCell>
            <mxCell id="p2_i0" value="倒计时的钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f0" value="倒计时走单调钟；闹钟走墙钟；睡眠唤醒后补一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="136" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w0" value="仓里全是 time.time()，墙钟被 NTP 跳变 / 休眠一带就把时长算飞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="136" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i1" value="谁写落盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f1" value="落冷库 PG 表 timers：按进程键分行（web / cli 各一行，一条 upsert 原子）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="190" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w1" value="仓里没有原子写 helper，web 与 CLI 会同时开着" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="190" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i2" value="「开始或者结束」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f2" value="两种都做：一次性提醒；窗口两端（成对登记、成对撤销、可跨天）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="244" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w2" value="只做一次性，就把「结束」那端丢了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="244" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i3" value="错过的点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f3" value="补一次，并说明这是补的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="298" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w3" value="不补 = 静默丢任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="298" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i4" value="送达时机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f4" value="排队，等主 agent 下一次醒来开场注入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="352" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w4" value="它正忙的时候不插话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="352" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i5" value="阻塞时的读秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f5" value="等的时候在「过程步骤」里读秒：同一格原地改写；存档只留「开始等 / 等到了」两条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="406" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w5" value="逐秒新起一格 = 3 小时一万格，面板和存档都被灌爆（前端 收() 现在只有 think/reply 会续写）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="406" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i6" value="条件不足的判据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f6" value="程序判四项：时间 / 提醒什么 / 阻塞还是非阻塞 / 是否 ≤180" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="460" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w6" value="判据不写死，子 agent 会自由发挥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="460" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i7" value="动作面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f7" value="登记（闹钟·倒计时）/ 撤销（按 id 或最近那条）/ 列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="514" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w7" value="只有登记，第一天就会撞上「说错了要撤」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="514" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i8" value="设置页 · 定时任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f8" value="设置页左导航加一节「定时任务」：看挂着几条 / 撤掉某条（写操作走 POST，同 /api/关闭）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="568" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w8" value="跟「撤销 / 列表」是同一件事的两个面，不能只做在对话里" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="568" width="240" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_i9" value="并发上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="160" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_f9" value="默认 20 条；同一时刻多条到点按登记先后" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="210" y="622" width="330" height="50" as="geometry"/></mxCell>
            <mxCell id="p2_w9" value="防主 agent 乱挂一堆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=10;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="550" y="622" width="240" height="50" as="geometry"/></mxCell>
