        <mxCell id="1" parent="0" />
        <mxCell id="h4" parent="1" value="启动 · 自检 · 打包 · 开源（成品形状）&#10;自检 30 项全绿才起模型拉主程序；打包走「不编译」路线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1"><mxGeometry height="56" width="670" x="80" y="14" as="geometry"/></mxCell>
        <mxCell id="s1" parent="1" value="cli.py · collaplex-agent&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;web 起页面(:8791) / 自检 / 模型 / chat —— 底下同一套&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Courier New;" vertex="1"><mxGeometry height="50" width="230" x="300" y="96" as="geometry"/></mxCell>
        <mxCell id="s2" parent="1" value="selfcheck.py · 30 项" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Courier New;" vertex="1"><mxGeometry height="50" width="230" x="300" y="170" as="geometry"/></mxCell>
        <mxCell id="d1" parent="1" value="全绿?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;" vertex="1"><mxGeometry height="70" width="150" x="340" y="250" as="geometry"/></mxCell>
        <mxCell id="f1" parent="1" value="列出报错项 + 退出码 1&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;不拉主程序，先修完再来&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1"><mxGeometry height="56" width="216" x="52" y="258" as="geometry"/></mxCell>
        <mxCell id="s3" parent="1" value="start_models.sh&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;llama.cpp：主模型 :8790 + 向量 :8199&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Courier New;" vertex="1"><mxGeometry height="56" width="230" x="300" y="356" as="geometry"/></mxCell>
        <mxCell id="s4" parent="1" value="main.py 起对话" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Courier New;" vertex="1"><mxGeometry height="50" width="230" x="300" y="448" as="geometry"/></mxCell>
        <mxCell id="g1" parent="1" value="模型 API GET 检查（四组各一发 /models）&#10;主模型 · 向量模型 · 执行体 · 子 agent&#10;401→Key 不对 ｜ 连不上→服务起了吗&#10;执行体 / 子 agent 没配 = 回落主模型那套，不算错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="116" width="268" x="592" y="150" as="geometry"/></mxCell>
        <mxCell id="g2" parent="1" value="其余检查项&#10;配置：.env 键齐 / 四份 json 能读（含思考路由 · 外援触发）&#10;依赖：skill 用到的包在不在（子进程 find_spec）&#10;库：两层库 / 语料目录 / 别名 / 清洗心跳&#10;代码：10 个入口都能编译（三 agent + cli + watchdog + web）&#10;结构：skill 目录齐 / 提示词齐 / 索引跟目录对得上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="140" width="268" x="592" y="288" as="geometry"/></mxCell>
        <mxCell id="pk" parent="1" value="打包：pack_bundle.sh（项目代码一行不改）&#10;① 拿 python-build-standalone install_only 当基座（★ 绝不 strip）&#10;② 依赖 pip 装到 runtime/deps（--target），不建 venv&#10;③ 项目本体进包（不带 .venv / .env / 日志 / 缓存）&#10;④ 写 run.sh + .env.example（只有键名，值留空）&#10;⑤ zstd 压包 → dist/collaplex-agent-&lt;日期&gt;.tar.zst（48M，解压 188M）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="126" width="820" x="40" y="556" as="geometry"/></mxCell>
        <mxCell id="op" parent="1" value="开源：push_gitea.sh&#10;subtree split 把每个 skill 的历史真拆出来&#10;→ 13 个公开仓（主仓 + 12 skill）：&#10;file / linux / math / mtp / orchestra / outsource / rag / search / seek / skill_search / timer / vision&#10;★ 开源前必须扫全历史（.env 曾进过历史）+ 查 Gitea 匿名门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="120" width="400" x="40" y="706" as="geometry"/></mxCell>
        <mxCell id="nn" parent="1" value="不编译的理由（当年实测）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#999999&quot;&gt;（旁注 · 不属于主流程）&lt;/font&gt;&#10;Nuitka 单文件能编出来（33M / 7 分钟），但原样跑不了：&#10;23 处 Path(__file__) 从临时目录找数据 → 报 FileNotFoundError；&#10;数据树 / .env / 服务 也编不进去 → 性价比低，改走压缩包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="100" width="390" x="470" y="706" as="geometry"/></mxCell>
        <mxCell id="x1" edge="1" parent="1" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
