        <mxCell id="bg6" parent="BG" value="push_gitea.sh · 一 skill 一仓&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;subtree split；13 个公开仓（主仓 + 12 skill）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Courier New;" vertex="1"><mxGeometry height="36" width="302" x="14" y="214" as="geometry"/></mxCell>
        <mxCell id="fl" parent="1" value="这轮怎么串起来&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#999999&quot;&gt;（旁注 · 不属于主流程）&lt;/font&gt;&#10;用户提问 → main.py 渲染/拦截 → 子 agent 检索 + 拼 skill → 模型 →&#10;主 agent 判断（够不够 / 要交办什么）→ 执行 agent 动手 → 产出入二层热库 →&#10;静默 20 分钟后被清洗成冷库知识 → 下一轮又能检索到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1"><mxGeometry height="190" width="250" x="740" y="92" as="geometry"/></mxCell>
