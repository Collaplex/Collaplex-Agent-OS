      <mxCell id="r4b" value="预算 0.02 未触发（改动量本来就小于预算）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="338" width="190" height="46" as="geometry" /></mxCell>
      <mxCell id="r4c" value="🟡 待扫小预算才有作用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="338" width="320" height="46" as="geometry" /></mxCell>
      <mxCell id="r5a" value="感受器/效应器神经元数量靠训练" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="390" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r5b" value="感受器 32 维手工特征、效应器 13 族（数量仍是我定的）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="190" height="46" as="geometry" /></mxCell>
