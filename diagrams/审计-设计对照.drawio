      <mxCell id="e5" value="⑤ 调制" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="h" target="n"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="a1" value="感受器多少神经元连 cnn 集群「不知道，怎么连不知道，全靠训练」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="330" height="50" as="geometry" /></mxCell>
      <mxCell id="a2" value="效应器多少神经元连 cnn 集群「不知道，怎么连不知道，全靠训练」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="330" height="50" as="geometry" /></mxCell>
      <mxCell id="a3" value="★ 回路（效应器→感受器）不是数据流边，&lt;b&gt;它本身就是训练过程&lt;/b&gt;：输出回灌成输入，一圈一圈地学（赫布，不是反向传播）；CNN 只有一个、像单个神经元；预布线先把线撒到非常多；激素调节该调节的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="505" width="345" height="90" as="geometry" /></mxCell>
      <mxCell id="h0" value="你的设计（要什么）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="290" height="30" as="geometry" /></mxCell>
      <mxCell id="h1" value="我的实现（做了什么）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="190" height="30" as="geometry" /></mxCell>
      <mxCell id="h2" value="判定" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="320" height="30" as="geometry" /></mxCell>
      <mxCell id="r0a" value="① 回路（效应器→感受器）= 训练过程本身" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r0b" value="v1/v2 当成数据流边（迭代到稳定）→ 输入信息被压平" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="190" height="46" as="geometry" /></mxCell>
      <mxCell id="r0c" value="🔴 读错＋实现错；已改真环境" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="320" height="46" as="geometry" /></mxCell>
      <mxCell id="r1a" value="② CNN 只有一个，像单个神经元" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="182" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r1b" value="v1 做成 N 个可训身份键；v3 改成 1 个 1D 卷积（4 参数）共享" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="182" width="190" height="46" as="geometry" /></mxCell>
      <mxCell id="r1c" value="🟢 已对齐（v3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="182" width="320" height="46" as="geometry" /></mxCell>
      <mxCell id="r2a" value="③ 预布线：训练开始先说撒到非常多" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="234" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r2b" value="v3 只有 32×13 = 416 条" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="234" width="190" height="46" as="geometry" /></mxCell>
