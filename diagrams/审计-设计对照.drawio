      <mxCell id="r6a" value="「感受器继续输入」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="442" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r6b" value="v3 落实：环境反馈每步回灌成下次输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="442" width="190" height="46" as="geometry" /></mxCell>
      <mxCell id="r6c" value="🟢 已对齐（v3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="442" width="320" height="46" as="geometry" /></mxCell>
      <mxCell id="r7a" value="三层模块存在 = 你讲的预布线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="494" width="290" height="46" as="geometry" /></mxCell>
      <mxCell id="r7b" value="已搭：反馈总线/情境快照/可塑图/效应器循环/赫布婴儿" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="494" width="190" height="46" as="geometry" /></mxCell>
