      <mxCell id="t" value="② 我实际实现的（现在是这个样子）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="900" height="30" as="geometry" /></mxCell>
      <mxCell id="g" value="已搭的五层骨架（实验/行为旋钮-20261007/）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="560" height="30" as="geometry" /></mxCell>
      <mxCell id="L0" value="&lt;b&gt;① 环境反馈总线&lt;/b&gt;&lt;br&gt;2343 步 / 294 轮（每条命令→结构化事件）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="560" height="58" as="geometry" /></mxCell>
      <mxCell id="L1" value="&lt;b&gt;② 情境快照&lt;/b&gt;&lt;br&gt;任务＋上一步动作＋上一步反馈＋已被拦几次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="560" height="58" as="geometry" /></mxCell>
      <mxCell id="L2" value="&lt;b&gt;③ 可塑图层&lt;/b&gt;&lt;br&gt;边权随奖励变（判据贡献版：基线 39.9 → 只加强 47.2%）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="242" width="560" height="58" as="geometry" /></mxCell>
      <mxCell id="L3" value="&lt;b&gt;④ 旋钮（CNN）&lt;/b&gt;&lt;br&gt;轮级行为 均衡 62.8%（桥一跳那档）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="308" width="560" height="58" as="geometry" /></mxCell>
      <mxCell id="L4" value="&lt;b&gt;⑤ 效应器循环&lt;/b&gt;&lt;br&gt;婴儿循环：冷启动 33%→75%；预布线首轮 100%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="374" width="560" height="58" as="geometry" /></mxCell>
      <mxCell id="pre" value="＋ 预布线.py：手写「任务类 → 本命做法」反射弧（零数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="446" width="560" height="40" as="geometry" /></mxCell>
      <mxCell id="k" value="④ 旋钮片（我设计的结构 ← 问题在这）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="520" height="30" as="geometry" /></mxCell>
      <mxCell id="k1" value="感受器&lt;br&gt;情境向量 1024 维（固定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="240" height="60" as="geometry" /></mxCell>
      <mxCell id="k2" value="N 个旋钮&lt;br&gt;身份键可训 ＋ 共享算子 ＋ 相邻一跳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="240" height="70" as="geometry" /></mxCell>
      <mxCell id="k3" value="效应器&lt;br&gt;15 个命令族（固定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="640" y="320" width="240" height="60" as="geometry" /></mxCell>
      <mxCell id="k1e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="k2e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="k4" value="参数量：N=1→1.0万，N=128→14万（身份键占六成六）&lt;br&gt;★ 参数量取决于单体大小＋是否共享，与旋钮个数几乎无关" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="250" height="90" as="geometry" /></mxCell>
      <mxCell id="k5" value="缺失（对比你的图）：&lt;br&gt;🔴 感受器/效应器的神经元数量是我定死的&lt;br&gt;🔴 连接拓扑是我设计的（不是训练出来的）&lt;br&gt;🔴 没有 效应器→感受器 回路&lt;br&gt;🔴 没有 激素调控 那一层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="900" y="215" width="250" height="165" as="geometry" /></mxCell>
      <mxCell id="r" value="这一版的学习结果（2343 步全量，纯 CPU／0 元）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="560" height="30" as="geometry" /></mxCell>
      <mxCell id="r1" value="轮级行为（动手/先问/直接答）　均衡 &lt;b&gt;62.8%&lt;/b&gt;　🟢 可学" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="515" width="560" height="40" as="geometry" /></mxCell>
      <mxCell id="r2" value="步级命令（它实际用了什么命令）　均衡 8.7~10%　🔴 不可学" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="563" width="560" height="40" as="geometry" /></mxCell>
      <mxCell id="r3" value="步级结果（这一步会不会被拦）　均衡 41~42%　🔴 不可学" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="611" width="560" height="40" as="geometry" /></mxCell>
      <mxCell id="r4" value="层错位：「会不会被拦」不是情境的函数，是&lt;b&gt;命令自己的函数&lt;/b&gt;（语法闸查危险词），所以拿情境预测它必然失败 → 旋钮该学&lt;b&gt;轮级行为&lt;/b&gt;，不是步级命令/结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="661" width="1120" height="50" as="geometry" /></mxCell>
      <mxCell id="r5" value="赫布婴儿（按你的图接进真环境）：不学 33.3%（恒）｜赫布 &lt;b&gt;33.3%→50.0%&lt;/b&gt;｜赫布＋激素 与赫布相同（预算 0.02 未触发）　⇒ 机制通了，规模还小、激素待扫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="719" width="1120" height="44" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
