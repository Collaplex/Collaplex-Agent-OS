      <mxCell id="r3a" value="④ 正常赫布学习（无反向传播）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="286" width="290" height="46" as="geometry" /></mxCell>
