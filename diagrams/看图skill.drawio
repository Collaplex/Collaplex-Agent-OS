      <mxCell id="p3_r390_a" value="落盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="220" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r390_b" value="logs/vision/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="390" width="200" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r390_c" value="一行账（谁读的 / 耗时 / 图多大）＋ 一份产出 .md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="390" width="560" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_gate" value="闸放程序侧（命令路由那一关硬拦）—— 跟 search 同款: 挂 SKILL.md 侧是软约束, 拦不住发疯。&#10;max_per_round 100 · round_gap_seconds 1800（停手超 30 分钟自动开新一轮）· state cache/budget.json&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vision_core.budget()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="1000" height="60" as="geometry"/></mxCell>
      <mxCell id="p3_vh1" value="编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="70" height="40" as="geometry"/></mxCell>
      <mxCell id="p3_vh2" value="验什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="536" width="300" height="40" as="geometry"/></mxCell>
      <mxCell id="p3_vh3" value="判据 / 实测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="536" width="610" height="40" as="geometry"/></mxCell>
      <mxCell id="p3_V1_a" value="V1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="70" height="48" as="geometry"/></mxCell>
