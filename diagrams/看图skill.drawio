      <mxCell id="p3_V2_c" value="★实测: 加了 --mmproj 后本地也读出来了（38.2s/张, 视觉塔在 CPU 上算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="642" width="610" height="48" as="geometry"/></mxCell>
