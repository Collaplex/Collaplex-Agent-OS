      <mxCell id="p3_r166_b" value=".jpg .jpeg .png .webp .gif .bmp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="166" width="200" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r166_c" value="视觉模型认的就这几样" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="166" width="560" height="48" as="geometry"/></mxCell>
