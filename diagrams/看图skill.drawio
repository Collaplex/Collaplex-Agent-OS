<mxfile host="app.diagrams.net">
  <diagram name="1-它管什么" id="p1">
    <mxGraphModel dx="1000" dy="800" grid="0" pageWidth="1000" pageHeight="580">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
      <mxCell id="p1_t" value="看图 skill · 它管什么" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="p1_r" value="rag — 自家的事&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;项目代码 / 配置 / 语料&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="260" height="70" as="geometry"/></mxCell>
      <mxCell id="p1_s" value="search — 外面的事（页面上写的字）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;HTML → 正文段落; 空壳页只回截图&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="60" width="260" height="70" as="geometry"/></mxCell>
      <mxCell id="p1_v" value="vision — 图里画的东西&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;一张本地图片 → 文字; 不留库&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="260" height="70" as="geometry"/></mxCell>
      <mxCell id="p1_q" value="答案在哪？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="175" width="200" height="56" as="geometry"/></mxCell>
      <mxCell id="p1a" value="在我家项目里" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_q" target="p1_r"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p1b" value="在页面的字里" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_q" target="p1_s"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p1c" value="只在图上" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_q" target="p1_v"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p1_j" value="接的是 search 留在那儿的一节：&#10;联网搜索 §1 主链有支路「汇总 --图片--&gt; 返回结果（直接回）」，§4 又写「抓到了但清洗后没内容 → 只回截图」。&#10;图能回到手上，但全项目没有一处会读它 —— search 的 SKILL.md 只能把 shot_path 给出去。交给谁？这一节就是 vision。&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;diagrams/联网搜索skill-架构.md §1 / §4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="265" width="880" height="90" as="geometry"/></mxCell>
      <mxCell id="p1_k1" value="硬约束一：图只在要用的时候看一眼&#10;· 不预读、不批量读、不因为顺手去读&#10;· search 取回来一张截图，不自动触发读图；要不要看由当时那件事决定&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;SKILL.md 触发条件: 该看 / 不该看&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="430" height="110" as="geometry"/></mxCell>
      <mxCell id="p1_k2" value="硬约束二：图不寄存&#10;· 不进会话历史、不进任何库、不落第二份&#10;· 那一次请求发出去，回来的是文字；图还在它原本躺着的盘上，哪儿也没多&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;见 §1 主链第 3/4 步&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="430" height="110" as="geometry"/></mxCell>
      <mxCell id="p1_n" value="为什么这样定：上下文是子 agent 的活，图这种大块的东西一旦进去就洗不干净（噪声税）。vision 只做一件事 —— 替当时那件事看一眼，把看到的写成字交出去。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="880" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2-主链与两条路" id="p2">
    <mxGraphModel dx="1000" dy="800" grid="0" pageWidth="1060" pageHeight="720">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
      <mxCell id="p2_t" value="看图 skill · 主链（5 步）＋ 两条路" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="p2_1" value="命令路由&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;main.py: 动作表 → see / status / retrieve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="230" height="58" as="geometry"/></mxCell>
      <mxCell id="p2_2" value="拿图（在不在 / 后缀 / 大小）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;vision_core.check_image: 不通过 → 一句人话, 退出码 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="230" height="58" as="geometry"/></mxCell>
      <mxCell id="p2_3" value="看一眼 · 主路（云端视觉）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;see.py: .env 的 OPENAI_*（现在 mimo-v2.6-flash）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="230" height="58" as="geometry"/></mxCell>
      <mxCell id="p2_4" value="看一眼 · 兜底（本地 qwen3-vl-8b）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;8790; ★起它必须带 --mmproj（视觉塔, 放 CPU 算）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="230" height="58" as="geometry"/></mxCell>
      <mxCell id="p2_5" value="交出去（文字 ＋ 一行账）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;stdout 文字; logs/vision/ 记谁读的/耗时/图多大&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="230" height="58" as="geometry"/></mxCell>
      <mxCell id="p2a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_1" target="p2_2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_2" target="p2_3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2c" value="报错 / 超时 / 回来是空的" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_3" target="p2_4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_4" target="p2_5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2e" value="成了（主路好的时候不切兜底）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_3" target="p2_5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_x1" value="两条都不通 → 照实说&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;「两条路都不通 —— 图里有什么, 我不知道 (绝不编)」; 退出码 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="260" height="58" as="geometry"/></mxCell>
      <mxCell id="p2f" value="还是不通" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p2_4" target="p2_x1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_x2" value="闸到顶 → 明说&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;单轮 20 张（防钻牛角尖）; 退出码 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="260" height="58" as="geometry"/></mxCell>
      <mxCell id="p2g" value="看太多张了" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p2_2" target="p2_x2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_n1" value="第 3、4 步里那张图只活在这一次请求里：base64 进请求体，发出去，回来文字，图就散了。&#10;没有第 6 步「存起来」—— 这是刻意的。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="460" height="70" as="geometry"/></mxCell>
      <mxCell id="p2_n2" value="单次一张图（看一眼就是一眼）；要看好几张就发几条命令。&#10;谁读的必须说出来（头部标 云端 / 本地）—— 不然出了错分不清是哪条路的账。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="550" y="560" width="460" height="70" as="geometry"/></mxCell>
      <mxCell id="p2_n3" value="★ 不重试、不静默：拿不到内容就是拿不到，绝不编一段「图里大概写着…」糊过去。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="950" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
