      <mxCell id="p3_r334_b" value="180 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="334" width="200" height="48" as="geometry"/></mxCell>
