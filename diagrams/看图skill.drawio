      <mxCell id="p3_r222_b" value="100 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="222" width="200" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r222_c" value="防发疯（跟 search 一个档; 2026-10-09 老板定: 单次对话上限 100）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="222" width="560" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r278_a" value="max_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="220" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r278_b" value="1024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="278" width="200" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r278_c" value="描述一张图够了; 太小会被思考吃光" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="278" width="560" height="48" as="geometry"/></mxCell>
