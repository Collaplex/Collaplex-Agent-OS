      <mxCell id="p3_V3_b" value="兜底没带 mmproj" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="120" y="698" width="300" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_V3_c" value="★实测原话: HTTP 500 image input is not supported —— 不静默当成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="698" width="610" height="48" as="geometry"/></mxCell>
