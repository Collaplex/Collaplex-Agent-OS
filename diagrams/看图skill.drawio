      <mxCell id="p3_r110_a" value="单图大小上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r110_b" value="8MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="200" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_r110_c" value="比 search 的单页 5MB 松一点（截图本来就大）, 但不能没闸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="560" height="48" as="geometry"/></mxCell>
