      <mxCell id="p3_V7_c" value="★实测: 自检 24/24, rag 检索不受影响" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="922" width="610" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_V8_a" value="V8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="70" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_V8_b" value="命令库能被检索到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="120" y="978" width="300" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_V8_c" value="★实测: skill 索引 10 条(含 vision)、命令库索引 2 条, find 能命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="430" y="978" width="610" height="48" as="geometry"/></mxCell>
      <mxCell id="p3_steps" value="加一个 skill 要做的三步（没有注册表）&#10;① 建命令库索引: .venv/bin/python skill/vision/scripts/retrieve.py index&#10;② 重扫 skill 索引: .venv/bin/python skill/skill_search/main.py index（扫各 SKILL.md frontmatter）&#10;③ 自检清单加它: selfcheck.py 的 wanted = (...) 加上 vision&#10;外加一处前置改动: start_models.sh 主模型那行加 --mmproj（mmproj-Qwen3-VL-8B-Instruct-F16.gguf 1.16G 已在盘上）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;不加 mmproj, 兜底就是假的&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1044" width="1000" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
