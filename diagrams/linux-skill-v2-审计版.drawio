<mxfile host="app.diagrams.net">
  <diagram name="linux-skill 审计版" id="linux-skill-v2">
    <mxGraphModel dx="1200" dy="900" grid="0" pageWidth="1450" pageHeight="1576">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="L1" value="用户提问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="110" y="60" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="L2" value="judge 判断「缺能力」？&lt;br&gt;现在把「要动这台机器」判成不缺 → need=false，整条链走不到&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config/skills/judge.md　★必改：补一条「要动这台机器 = 缺能力」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="110" y="140" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="L3" value="search_skills 挑 skill&lt;br&gt;清单里只有 seek / rag / skill_search，挑不出 → 放弃支链&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;main.py: find_skill_for / pick_skill　★必改：命令库要能被检索到&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="110" y="246" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="M1" value="主 agent：指定 skill + 声明要干的活&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;main.py: pick_skill → 声明&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M2" value="下达 exec agent（提示词 = 命中的 SKILL.md）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;main.py → exec_agent.run_task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="152" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M3" value="exec 命中 skill → 看 SKILL.md&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;exec_agent.run_task(skill_path)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="244" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M4" value="① 检索命令库（拿声明当查询）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;新增　skill/linux/commands-index.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="336" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M5" value="② 取回相似条目：意图 → 命令 → 解释&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;新增　一片一条，不抄 man&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="428" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M6" value="③ 查看用法：参数 / 输出怎么读 / 本机实情 / 坑&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;新增&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M7" value="④ 危险闸：只读优先；写操作要声明里显式说&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config/agent.json: exec.blocked_fragments（已有，接上）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="612" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M8" value="⑤ 发送命令（模型出命令 JSON）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;exec_agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="704" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M9" value="⑥ 解释器执行（超时 180s）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;config/agent.json: exec.timeout_seconds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="796" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M10" value="⑦ 返回数据（stdout + 退出码）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;exec_agent 回灌给模型&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="888" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M11" value="⑧ 成功要过两道闸，都过才算成功&lt;br&gt;① 程序：退出码 0&lt;br&gt;② 模型：结果符合主 agent 声明的意图&lt;br&gt;（127 / 2 / 126 及语法错 → 拼错类，自愈）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;★退出码=程序判；对不对得上声明=模型判&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="980" width="280" height="132" as="geometry"/></mxCell>
        <mxCell id="M12" value="⑨ 成功：摘要 + 关键行 + 完整输出落文件&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;新增　完整输出落 skill/linux/logs/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="1138" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="M13" value="⑩ 回二层热库 → 下一轮子 agent 检索得到&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;sub_agent.save_to_tier2　★原稿缺这条成功回边&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="1230" width="280" height="62" as="geometry"/></mxCell>
        <mxCell id="R2" value="⑫ 其它失败（权限 / 环境不满足 / 跑通但结果不对路）&lt;br&gt;回二层热库 + 回主 agent 调整声明：只给 1 次&lt;br&gt;还不行 → 向用户说明情况&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;原稿第 23 格　★现在 exec 跑完就交差，没有回主 agent 的通道，要新开&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="996" width="380" height="86" as="geometry"/></mxCell>
        <mxCell id="GT" value="附注 · 新增产物与做法（不属于主流程）" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1010" y="20" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="G1" value="新增产物 skill/linux/&lt;br&gt;SKILL.md（规范）· metadata.json（声明式）&lt;br&gt;commands/*.md（一片一条）· commands-index.json&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;跟 rag / skill_search 同款结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="380" height="88" as="geometry"/></mxCell>
        <mxCell id="G2" value="命令库怎么建&lt;br&gt;rag 的 embed.json 加一层 tiers → 索引落 skill/linux/&lt;br&gt;检索复用现成的两路（字符串 + 向量）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;零改检索代码（search_with_alias 那套照搬）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="380" height="88" as="geometry"/></mxCell>
        <mxCell id="G3" value="命令库怎么长&lt;br&gt;跑成功才回填「意图 → 命令」&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;同「没真跑过命令的产出不入库」那条规矩&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="260" width="380" height="88" as="geometry"/></mxCell>
        <mxCell id="G4" value="热库别塞全量输出&lt;br&gt;ls 几百行会污染检索&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;只存摘要 + 关键行 + 文件路径&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="380" height="88" as="geometry"/></mxCell>
        <mxCell id="LEG" value="颜色：蓝 = 原稿保留　红 = 必改（照原稿接会走不通）　黄 = 建议（能跑但要收口）　绿 = 新增产物 / 新增步骤" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="110" y="1376" width="1280" height="26" as="geometry"/></mxCell>
        <mxCell id="N1" value="① 两个重试合成一个总预算：自愈 3 次 + 回主 agent 1 次。分开算 = 3×3 = 9 轮，本地 11 tok/s，用户得等十分钟。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="110" y="1410" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="N2" value="② 跨轮闭环（不另画回环）：⑩ 进热库 → 下一轮子 agent recall 命中 → 回到左列「用户提问」。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="110" y="1446" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="N3" value="③ 自愈循环只回「检索命令库」不回「查看用法」—— 失败可能是条目取偏了，也可能是用法看错，回后者救不了前者。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="110" y="1482" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="N4" value="④ ⑧ 那两道闸分工别混：退出码是程序判（确定性），「结果符不符合指令意思」是模型判（语义）—— 两道都过才算成功，有一道不过就走失败。" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="110" y="1518" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="e_M1_M2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M1" target="M2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M2_M3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M2" target="M3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M3_M4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M3" target="M4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M4_M5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M4" target="M5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M5_M6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M5" target="M6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M6_M7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M6" target="M7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M7_M8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M7" target="M8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M8_M9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M8" target="M9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M9_M10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M9" target="M10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_M10_M11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M10" target="M11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l3" value="缺能力 → 进左链" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="L3" target="M1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ok" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M11" target="M12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="M12" target="M13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_heal" value="拼错类 → 自愈，限 3 次" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="M11" target="M4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_other" value="其它失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="M11" target="R2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_resend" value="重新声明（限 1 次）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="R2" target="M1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_g0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G1" target="G2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G2" target="G3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="G4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>