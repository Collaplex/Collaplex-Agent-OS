      <mxCell id="p4_V4_b" value="404 / 域名不存在" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="120" y="290" width="340" height="52" as="geometry"/></mxCell>
      <mxCell id="p4_V4_c" value="回具体报错文本（带码或域名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="290" width="560" height="52" as="geometry"/></mxCell>
