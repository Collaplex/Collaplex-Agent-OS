      <mxCell id="p1_t" value="联网搜索 skill · 主链补全版（原稿不动，本图是补全后的形状）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="p1_1" value="调用&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;skill/search/SKILL.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_2" value="命令路由&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;main.py: 动作表 → scripts/run.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_3" value="★闸门  单轮 ≤100 次 ＋ 体积上限&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;run.py: 先过闸, 不通过直接回原因&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="240" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_4" value="真浏览器抓取（bing ＋ 百度）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scripts/browser.py: 防爬虫识别＝用真浏览器; 常驻 + 闲置看门狗&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_5" value="错误分类&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;browser.py: 见第 3 页失败四类&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_6" value="程序清洗（HTML → 标题 ＋ 正文段落）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;scripts/article.py（已写好, 直接复用）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="510" width="210" height="58" as="geometry"/></mxCell>
      <mxCell id="p1_7" value="清洗后还有东西吗？&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;低于阈值 → 只回截图&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="600" width="210" height="84" as="geometry"/></mxCell>
