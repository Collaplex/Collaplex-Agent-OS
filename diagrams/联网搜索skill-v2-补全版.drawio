      <mxCell id="p2_t" value="数据面：热库（检索面）＋ 语料库（新表·长期）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="900" height="30" as="geometry"/></mxCell>
      <mxCell id="p2_1" value="抓取产物（标题 ＋ 正文 ＋ 截图路径 ＋ 状态码）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="280" height="56" as="geometry"/></mxCell>
      <mxCell id="p2_2" value="去重键：URL 归一 ＋ 正文指纹&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;同一条从 bing 和百度各来一次 → 只算一条&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="280" height="56" as="geometry"/></mxCell>
