      <mxCell id="p2a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_1" target="p2_2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_2" target="p2_3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_h" value="热库（表 search_hot）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;列: id / url / 域名 / 来源(bing·百度·直连·渲染) / 标题 / hash / idx / text&#10;        / embedding vector(1024) / 抓取时间 / 状态码 / 截图路径 / 热到什么时候&#10;索引: unique(url 归一, hash) · hnsw(embedding)&#10;★ 形状与 rag_chunks 对齐 —— 向量与检索算法整套复用 rag&#10;★ 热是一份：不分来源，来源只是列（bing/百度/直连/渲染）&#10;★ 截图跟 TTL 一起清（热库里的没了，截图也删）&#10;★ 检索只查这里（热的才进检索面）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="350" width="430" height="280" as="geometry"/></mxCell>
      <mxCell id="p2_c" value="语料库（新表 search_corpus · 供后续人复用）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;列: 与热库同 ＋ 首次抓到 / 最后抓到 / 命中次数&#10;去重: 长期唯一（URL 归一 ＋ 正文指纹）&#10;留存: 90 天 或 2GB，先到先清最老（我定的档，可改）&#10;★ 就是你说的「专门放搜索引擎语料的库」——人也能直接查&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="350" width="460" height="280" as="geometry"/></mxCell>
      <mxCell id="p2c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_3" target="p2_h"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_4" value="下沉任务（TTL 到期）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;cron 定时, 去重后并入&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="200" height="56" as="geometry"/></mxCell>
      <mxCell id="p2_5" value="检索（只搜热的）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="810" width="200" height="56" as="geometry"/></mxCell>
      <mxCell id="p2d" value="热到 24h" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_h" target="p2_4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2e" value="并入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_4" target="p2_c"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2f" value="查这里" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_h" target="p2_5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2g" value="不进检索面" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="p2_c" target="p2_5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p2_p" value="参数（旁注 · 不属于主流程）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;热窗口 TTL      24 小时&#10;语料库留存      90 天 / 2GB&#10;单轮命令上限    100 次&#10;单页字节上限    5MB&#10;单次（一条命令）20MB&#10;落盘总量上限    2GB（LRU 清最老）&#10;&#10;以上都是我先定的档，&#10;你说改哪个就改哪个&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="280" height="260" as="geometry"/></mxCell>
      <mxCell id="p2_nt" value="★ 为什么分两层：你说「检索只搜热的」——那就必须有个热的地方，而语料库要长期留着给人复用，两者的寿命不一样（24 小时 vs 90 天），挤在一张表里就没法各自定 TTL。★ 抓取先入热库；TTL 到期由下沉任务并入语料库，热库里清掉 —— 跟项目里「二层热库 → refine 下沉冷库」是同一套路子。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="1360" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3-失败与兜底" id="p3">
    <mxGraphModel dx="1000" dy="800" grid="0" pageWidth="1100" pageHeight="980">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
      <mxCell id="p3_t" value="失败语义与兜底（你定的口径：不是 HTTPS 错、也不是超时，就回具体报错）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="30" as="geometry"/></mxCell>
      <mxCell id="p3_1" value="抓取（真浏览器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="240" height="56" as="geometry"/></mxCell>
      <mxCell id="p3_2" value="响应超时？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="240" height="80" as="geometry"/></mxCell>
      <mxCell id="p3_3" value="HTTPS / 证书错？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="240" height="80" as="geometry"/></mxCell>
      <mxCell id="p3_4" value="响应正常吗？（2xx）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;404 / 域名不存在 / 站点拒绝 都走否&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="240" height="84" as="geometry"/></mxCell>
      <mxCell id="p3_5" value="程序清洗（HTML → 正文段落）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="530" width="240" height="56" as="geometry"/></mxCell>
      <mxCell id="p3_6" value="清洗后有内容吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="240" height="84" as="geometry"/></mxCell>
      <mxCell id="p3_7" value="切片 → 入热库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="750" width="240" height="56" as="geometry"/></mxCell>
      <mxCell id="p3_a" value="回「响应超时」＋ URL&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;这类没有更具体的原因&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="172" width="280" height="56" as="geometry"/></mxCell>
      <mxCell id="p3_b" value="回「HTTPS 错误」＋ URL&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;同上, 这两类自成一类&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="292" width="280" height="56" as="geometry"/></mxCell>
      <mxCell id="p3_c" value="回具体报错：404 / 站点不存在 / 站点拒绝&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;例: HTTP 404 查无此页 · 域名不存在: xxx.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="414" width="280" height="76" as="geometry"/></mxCell>
      <mxCell id="p3_d" value="只回截图&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;清洗出来没东西就别硬塞空正文&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="634" width="280" height="56" as="geometry"/></mxCell>
      <mxCell id="p3a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_1" target="p3_2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3b" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_2" target="p3_3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3c" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_3" target="p3_4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3d" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_4" target="p3_5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_5" target="p3_6"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3f" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_6" target="p3_7"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3g" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p3_2" target="p3_a"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3h" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p3_3" target="p3_b"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3i" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p3_4" target="p3_c"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3j" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#cc0000;fontColor=#cc0000;" edge="1" parent="1" source="p3_6" target="p3_d"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3_z1" value="闸门 ＋ 浏览器看门狗（程序侧硬拦）&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;单轮 &gt;100 次 → 拦&#10;体积超上限 → 拦&#10;浏览器闲置超时 → 杀&#10;被拦 / 被杀都回一句人话, 不静默&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="105" as="geometry"/></mxCell>
      <mxCell id="p3k" value="放行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_z1" target="p3_1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="p3_z2" value="失败一律回原因，不重试不静默&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#666666&quot;&gt;取不到 / 清洗空 / 切片空 / 入库失败&#10;四种都直接回一句带原因的话&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="305" width="260" height="110" as="geometry"/></mxCell>
      <mxCell id="p3_nt" value="★ 四类出口：①响应超时 ②HTTPS 错误 ③具体报错（404 / 站点不存在 / 站点拒绝）④正常但清洗后没内容 → 只回截图。前两类自成一类（本身就说不出更具体的），第三类才叫「具体报错」——它是从抓取这一关出来的，不是从清洗。★ 兜底闸：100 次是防模型发疯的次数闸，体积闸是防打爆磁盘（本机 NVMe 曾只剩 11G）。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1020" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
