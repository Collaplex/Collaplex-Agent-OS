      <mxCell id="p4_V3_a" value="V3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="70" height="52" as="geometry"/></mxCell>
      <mxCell id="p4_V3_b" value="防识别（用真浏览器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="340" height="52" as="geometry"/></mxCell>
      <mxCell id="p4_V3_c" value="对拦 HTTP 抓取的站，浏览器能拿到 html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="560" height="52" as="geometry"/></mxCell>
