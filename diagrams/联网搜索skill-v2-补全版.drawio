      <mxCell id="p4_h1" value="编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="70" height="40" as="geometry"/></mxCell>
      <mxCell id="p4_h2" value="验什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="340" height="40" as="geometry"/></mxCell>
