      <mxCell id="p4_V2_b" value="百度那一路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="340" height="52" as="geometry"/></mxCell>
